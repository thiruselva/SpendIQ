# SpendIQ Environment Variables
# Copy this to .env and fill in your keys

# ── Demo Mode ────────────────────────────────────────────────
# true  → uses data/spendiq_demo.db (pre-seeded with sample data)
# false → uses data/spendiq.db (your real data)
# Switching just changes which DB file is used — nothing is deleted.
DEMO_MODE=false

# ── AI Provider ──────────────────────────────────────────────
# Set ONE of these API keys. SpendIQ auto-detects which is available.
# If both are set, Gemini is used by default (override with AI_PROVIDER).

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic API Key (alternative to Gemini)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Force a specific provider: "gemini" or "anthropic" (optional)
# AI_PROVIDER=gemini

# ── Email Sync (optional) ───────────────────────────────────
# Gmail OAuth2
# GMAIL_CLIENT_ID=your-gmail-oauth-client-id
# GMAIL_CLIENT_SECRET=your-gmail-oauth-secret

# Outlook / Microsoft Graph API
# OUTLOOK_CLIENT_ID=your-outlook-client-id
# OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
